classDiagram
    class Usuario {
        +id: UUID
        +correo: string
    }
    class Presupuesto {
        +id: UUID
        +montoSemanal: Centavos
        +diaInicioSemana: DiaSemana
    }
    class Compromiso {
        +id: UUID
        +denominacion: string
        +monto: Centavos
        +fechaLimite: FechaIso
        +ocurrencias: int
        +generarVencimientos() Vencimiento[]
    }
    class Vencimiento {
        +compromisoId: UUID
        +ocurrencia: int
        +fecha: FechaIso
        +monto: Centavos
    }
    class IngresoExtra {
        +id: UUID
        +monto: Centavos
        +fecha: FechaIso
    }
    class MetaAhorro {
        +montoObjetivo: Centavos
        +fechaObjetivo: FechaIso
    }
    class Plan {
        +id: UUID
        +generadoEn: datetime
        +fechaReferencia: FechaIso
        +inicioHorizonte: FechaIso
        +finHorizonte: FechaIso
        +explicacion: string
    }
    class EvaluacionMeta {
        +montoObjetivo: Centavos
        +fechaObjetivo: FechaIso
        +ahorroPosible: Centavos
        +viable: boolean
        +faltante: Centavos
    }
    class AsignacionSemanal {
        +numeroSemana: int
        +fechaInicio: FechaIso
        +fechaFin: FechaIso
        +montoDisponible: Centavos
        +montoApartado: Centavos
        +montoVencimientos: Centavos
        +remanente: Centavos
        +aporteMeta: Centavos
        +sobrecargada: boolean
        +enDeficit: boolean
    }
    class Advertencia {
        +tipo: string
    }

    Usuario "1" --> "0..1" Presupuesto : declara
    Usuario "1" --> "0..*" Compromiso : registra
    Usuario "1" --> "0..*" IngresoExtra : registra
    Usuario "1" --> "0..1" MetaAhorro : define
    Usuario "1" --> "0..*" Plan : genera
    Compromiso "1" --> "1..*" Vencimiento : deriva
    Plan "1" --> "1..*" AsignacionSemanal : contiene
    Plan "1" --> "0..1" EvaluacionMeta : evalua
    Plan "1" --> "0..*" Advertencia : informa
    AsignacionSemanal "1" --> "0..*" Vencimiento : incluye
